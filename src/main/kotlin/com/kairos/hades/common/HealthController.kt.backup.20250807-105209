package com.kairos.hades.common

import org.springframework.http.ResponseEntity
import org.springframework.web.bind.annotation.GetMapping
import org.springframework.web.bind.annotation.RequestMapping
import org.springframework.web.bind.annotation.RestController
import java.time.LocalDateTime
import java.time.format.DateTimeFormatter

@RestController
@RequestMapping("/api/v1/health")
class HealthController {

    @GetMapping
    fun getSystemHealth(): ResponseEntity<Map<String, Any>> {
        val response = mapOf(
            "status" to "UP",
            "timestamp" to LocalDateTime.now().format(DateTimeFormatter.ISO_LOCAL_DATE_TIME),
            "application" to "Hades Backend",
            "version" to "0.0.1-SNAPSHOT",
            "message" to "Basic health check - infrastructure health checks disabled temporarily"
        )

        return ResponseEntity.ok(response)
    }

    @GetMapping("/database")
    fun getDatabaseHealth(): ResponseEntity<Map<String, Any>> {
        val response = mapOf(
            "status" to "UNKNOWN",
            "timestamp" to LocalDateTime.now().format(DateTimeFormatter.ISO_LOCAL_DATE_TIME),
            "component" to "PostgreSQL Database",
            "message" to "Database health check disabled temporarily"
        )

        return ResponseEntity.ok(response)
    }

    @GetMapping("/redis")
    fun getRedisHealth(): ResponseEntity<Map<String, Any>> {
        val response = mapOf(
            "status" to "UNKNOWN",
            "timestamp" to LocalDateTime.now().format(DateTimeFormatter.ISO_LOCAL_DATE_TIME),
            "component" to "Redis Cache",
            "message" to "Redis health check disabled temporarily"
        )

        return ResponseEntity.ok(response)
    }
}
